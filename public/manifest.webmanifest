{
  "name": "Start To Up",
  "short_name": "Start To Up",
  "description": "From ideas to impact. Share safely, build visibly and grow together.",
  "lang": "en-ZA",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f7f9fc",
  "theme_color": "#071449",
  "icons": [
    {
      "src": "/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Build media",
      "url": "/app/media",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Programs",
      "url": "/app/programs",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
